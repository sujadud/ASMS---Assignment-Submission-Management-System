# ASP.NET Core Web API Environment Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# PostgreSQL Database Connection String
ConnectionStrings__DefaultConnection=Host=localhost;Database=asms_db;Username=postgres;Password=postgres

# JWT Authentication Settings
JwtSettings__Secret=ASMS_Super_Secret_JWT_Signing_Key_2026_OnnoRokom_Recruitment_Project_Key_Must_Be_Long!
JwtSettings__Issuer=ASMS_API
JwtSettings__Audience=ASMS_Client
JwtSettings__ExpiryMinutes=1440

# Storage Provider Strategy ("Local" or "S3")
Storage__Provider=Local
Storage__LocalStoragePath=wwwroot/uploads
